{
    "ReverseProxy": {
        "Routes": {
            "users": {
                "ClusterId": "usersCluster",
                "Match": {
                    "Path": "/users/{**catch-all}"
                }
            },
            "books": {
                "ClusterId": "booksCluster",
                "Match": {
                    "Path": "/books/{**catch-all}"
                }
            },
            "movies": {
                "ClusterId": "moviesCluster",
                "Match": {
                    "Path": "/movies/{**catch-all}"
                }
            },
            "auth": {
                "ClusterId": "authCluster",
                "Match": {
                    "Path": "/auth/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "usersCluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7255/"
                    }
                }
            },
            "booksCluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7222/"
                    }
                }
            },
            "moviesCluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7062/"
                    }
                }
            },
            "authCluster": {
                "Destinations": {
                    "destination1": {
                        "Address": "https://localhost:7298/"
                    }
                }
            }
        }
    }

}
